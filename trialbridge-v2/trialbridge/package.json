{
  "name": "trialbridge",
  "version": "2.0.0",
  "description": "Find, understand and follow clinical trials. iOS-style Liquid Glass PWA.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
